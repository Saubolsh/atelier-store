# Copy to .env.local and fill in the values: cp .env.example .env.local

# Neon Postgres connection string (Neon Console -> your project -> Connect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# Better Auth signing/encryption secret, at least 32 characters.
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# Public base URL of the app
BETTER_AUTH_URL="http://localhost:3000"
